# Copy to .env and fill in your values. .env is gitignored.

# ComfyUI API base URL (tunnel/proxy or direct host:port)
COMFY_BASE="https://YOUR-COMFYUI-HOST"

# Optional: where the base workflow JSONs live (default: workflows/ inside video_test)
# WORKFLOWS_DIR="/path/to/workflows"

# Local LLM (llama-server, OpenAI-compatible) for the frontend "Craft" feature
LLM_BASE="https://YOUR-LLAMA-SERVER"

# Postgres asset catalog (every generated image/video is indexed here and the
# gallery file list is served from it; binaries stay in outputs/). The
# video_generator DB must exist (createdb video_generator). Local trust auth
# needs no password; set PG_PASSWORD otherwise.
PG_HOST="localhost"
PG_PORT="5432"
PG_DATABASE="video_generator"
PG_USER="postgres"
# PG_PASSWORD=""

# Scenario store: Postgres (scenarios table) is canonical by default.
# Set USE_SQLITE=true to use the legacy SQLite store
# (data/scenarios.sqlite, mirrored to Postgres) instead. Needs a restart.
# USE_SQLITE="true"

# Reface (face-swap studio): local insightface on CPU via scripts/reface.py.
# REFACE_PYTHON is the python with insightface + onnxruntime installed.
# INSWAPPER_MODEL is the inswapper_128.onnx file (auto-downloaded once from
# INSWAPPER_URL when missing — needs network on first swap).
# REFACE_PYTHON="python"
# INSWAPPER_MODEL="C:\Users\admin\.insightface\models\inswapper_128.onnx"
# INSWAPPER_URL="https://huggingface.co/ezioruan/inswapper_128.onnx/resolve/main/inswapper_128.onnx"
# REFACE_SIM_THRESHOLD="0.45"   # face-clustering join threshold (cosine)
# REFACE_MATCH_THRESHOLD="0.40" # per-frame target-match threshold (cosine)

